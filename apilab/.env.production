# Production Environment Variables
# Update VITE_API_URL dengan Cloudflare Worker URL Anda setelah deploy!

# Backend API URL (Cloudflare Workers)
# Format: https://apilab-mcp-api.<your-subdomain>.workers.dev
# Ganti <your-subdomain> setelah wrangler deploy!
VITE_API_URL=https://apilab-mcp-api.YOUR_SUBDOMAIN.workers.dev

# Note: API keys diinput via UI (tidak perlu di .env)
