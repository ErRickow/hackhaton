# E2B API Key (Required)
# Get your API key from: https://e2b.dev
VITE_E2B_API_KEY=your_e2b_api_key_here

# Neosantara AI API Key (Primary LLM Provider - Recommended)
# OpenAI-compatible API with nusantara-base model supporting function calling
# Get your API key from: https://api.neosantara.xyz
VITE_NEOSANTARA_API_KEY=your_neosantara_api_key_here

# Groq API Key (Alternative LLM Provider)
# Get your API key from: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here
